<Window x:Class="EaseeChargerClient.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Easee Charger Client" Width="1240" Height="860" MinWidth="1000" MinHeight="700" Background="#F2F6F4" FontFamily="Segoe UI" FontSize="14" Foreground="#173A30">
  <Grid Background="#F2F6F4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#FFFFFF" BorderBrush="#DCE5E0" BorderThickness="0,0,1,0" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="easee / client" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="Local charger workbench" Foreground="#62796E" Margin="0,0,0,28"/>
        <TextBlock Text="PRIVATE PROFILE" FontSize="11" FontWeight="Bold" Foreground="#62796E" Margin="0,0,0,12"/>
        <StackPanel IsEnabled="{Binding Idle}">
          <TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" Text="default"/>
          <Button Content="Open saved profile" Click="OpenProfile_Click"/>
          <Expander x:Name="SignInPanel" Header="Sign in to Easee" IsExpanded="True" Margin="0,12,0,0"><StackPanel>
          <TextBlock Text="Easee email or phone" Margin="0,12,0,0"/><TextBox x:Name="Username"/>
          <TextBlock Text="Password"/><PasswordBox x:Name="Password"/>
          <Button Content="Sign in securely" Click="Login_Click"/>
          <TextBlock Text="Tokens are encrypted for your Windows account. Your password is not saved." Foreground="#62796E" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,24"/>
          </StackPanel></Expander>
          <Separator Margin="0,0,0,20"/>
          <TextBlock Text="CHARGER SELECTION" FontSize="11" FontWeight="Bold" Foreground="#62796E" Margin="0,0,0,12"/>
          <Button Content="List my sites" Click="Sites_Click"/>
          <TextBlock Text="Site (name — site ID)"/><ComboBox x:Name="Sites" ItemsSource="{Binding Sites}" DisplayMemberPath="Label" SelectedValuePath="SiteId" SelectionChanged="Site_Changed" Padding="8" Margin="0,4,0,12"/>
          <TextBlock Text="Site ID"/><TextBox x:Name="SiteId"/>
          <Button Content="List site chargers" Click="Chargers_Click"/>
          <TextBlock Text="Charger (name — serial number)"/><ComboBox x:Name="SiteChargers" ItemsSource="{Binding Chargers}" DisplayMemberPath="Label" SelectedValuePath="SerialNumber" SelectionChanged="Charger_Changed" Padding="8" Margin="0,4,0,12"/>
          <TextBlock Text="Charger serial number (Easee id)"/><TextBox x:Name="ChargerId"/>
          <Button Content="Save selection" Click="Save_Click"/>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </Border>
    <Grid Grid.Column="1" Margin="28,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,20"><TextBlock Text="Your charging workspace" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Inspect your charger, receive live updates, and exercise the published API." Foreground="#62796E" Margin="0,6,0,0"/></StackPanel>
      <Border Grid.Row="1" Background="#E1EDE7" CornerRadius="7" Padding="14" Margin="0,0,0,18"><DockPanel><Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
      <TabControl Grid.Row="2" Background="White" BorderBrush="#DCE5E0">
        <TabItem Header="Charger &amp; live data"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel IsEnabled="{Binding Idle}"><Button Content="Read charger details" Click="Details_Click"/><Button Content="Read schedules" Click="Schedules_Click"/><Button Content="Start live updates" Click="Stream_Click"/><Button Content="Stop live updates" Click="StopStream_Click"/></WrapPanel>
          <TextBlock Grid.Row="1" Text="Latest observations · updates are received from Easee as they happen" Margin="0,12,0,10" Foreground="#62796E"/>
          <DataGrid Grid.Row="2" x:Name="Updates" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F2F6F4">
            <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180"/><DataGridTextColumn Header="Product" Binding="{Binding DeviceId}" Width="130"/><DataGridTextColumn Header="Observation" Binding="{Binding ObservationId}" Width="110"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns>
          </DataGrid>
        </Grid></TabItem>
        <TabItem Header="API workbench"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ComboBox x:Name="Operations" ItemsSource="{Binding Operations}" DisplayMemberPath="Summary" SelectionChanged="Operation_Changed" Padding="8" IsEnabled="{Binding Idle}"/>
          <TextBlock x:Name="OperationDescription" Grid.Row="1" TextWrapping="Wrap" Margin="0,10" Foreground="#62796E"/>
          <TextBox x:Name="Arguments" Grid.Row="2" AcceptsReturn="True" Height="90" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" ToolTip="Parameters as name=value, one per line. Site and charger selection are supplied automatically." IsEnabled="{Binding Idle}"/>
          <TextBox x:Name="Body" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="JSON request body, when required by the selected operation." IsEnabled="{Binding Idle}"/>
          <StackPanel Grid.Row="4"><TextBox x:Name="Traceparent" ToolTip="Optional traceparent header for OCPP provisioning workflows."/><WrapPanel IsEnabled="{Binding Idle}"><CheckBox x:Name="AllowWrite" Content="Allow this operation to change remote state" VerticalAlignment="Center" Margin="0,0,18,8"/><Button Content="Run selected operation" Click="Run_Click"/></WrapPanel></StackPanel>
        </Grid></TabItem>
        <TabItem Header="Results"><Grid Margin="18"><TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" Text="Independent client · local development build · no affiliation with Easee" Foreground="#62796E" FontSize="11" Margin="0,14,0,0"/>
    </Grid>
  </Grid>
</Window>
