{
  "schema": 1,
  "tasks": {
    "unit-tests-test-build-and-run-all-offline-nunit-5-suites": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/unit-tests-test-build-and-run-all-offline-nunit-5-suites.ps1",
          "shell": "pwsh"
        }
      ],
      "results": [
        "TestResults/OfflineVerified/*.trx"
      ]
    },
    "unit-tests-test-verify-the-library-package": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "pack",
            "EaseeChargerClient/EaseeChargerClient.csproj",
            "-c",
            "Release",
            "--output",
            "artifacts/nuget"
          ]
        }
      ]
    },
    "unit-tests-test-verify-packaged-xml-and-release-documents": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/unit-tests-test-verify-packaged-xml-and-release-documents.ps1",
          "shell": "pwsh"
        }
      ]
    },
    "api-contract-generated-3": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "restore",
            "EaseeChargerClient.slnx"
          ]
        }
      ]
    },
    "api-contract-generated-4": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/api-contract-generated-4.ps1",
          "shell": "pwsh"
        }
      ]
    },
    "api-contract-generated-5": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/api-contract-generated-5.ps1",
          "shell": "pwsh"
        }
      ]
    },
    "documentation": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/documentation-0.ps1",
          "shell": "pwsh"
        },
        {
          "executable": "pwsh",
          "script": "build/steps/documentation-1.ps1",
          "shell": "pwsh"
        }
      ],
      "documentation": {
        "config": "docfx_project/docfx.json",
        "site": "docfx_project/_site",
        "title": "EaseeChargerClient"
      }
    },
    "xml-documentation": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "--version"
          ]
        }
      ]
    },
    "release-assets": {
      "commands": [
        {
          "executable": "pwsh",
          "arguments": [
            "-NoProfile",
            "-File",
            ".github/scripts/Test-RequiredReleaseChecks.ps1"
          ]
        },
        {
          "executable": "pwsh",
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Regenerate.ps1"
          ]
        },
        {
          "executable": "pwsh",
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Test-Documentation.ps1"
          ]
        },
        {
          "executable": "pwsh",
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Build-Documentation.ps1"
          ]
        },
        {
          "arguments": [
            "-NoProfile",
            "-File",
            "${env:BUILD_AUTOMATION_COMPONENT_ROOT}/ReleasePublishing/Stage-Release.ps1",
            "-Root",
            ".",
            "-Version",
            "${env:RELEASE_VERSION}"
          ],
          "executable": "pwsh"
        },
        {
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Test-Package.ps1",
            "-Package",
            "artifacts/release/EaseeChargerClient.${env:RELEASE_VERSION}.nupkg"
          ],
          "executable": "pwsh"
        }
      ]
    }
  },
  "xmlDocumentation": {
    "projects": [
      "EaseeChargerClient/EaseeChargerClient.csproj",
      "EaseeChargerClient.Hosting/EaseeChargerClient.Hosting.csproj"
    ]
  }
}