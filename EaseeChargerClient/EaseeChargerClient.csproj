<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>EaseeChargerClient</PackageId>
    <RepositoryUrl>https://github.com/oznetmaster/EaseeChargerClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://oznetmaster.github.io/EaseeChargerClient/</PackageProjectUrl>
    <Description>Independent .NET client for the published Easee charger REST API and real-time SignalR observations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See RELEASE-NOTES.md for changes and compatibility notes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <InternalsVisibleTo Include="EaseeChargerClient.Tests" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../RELEASE-NOTES.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
  </ItemGroup>
</Project>
